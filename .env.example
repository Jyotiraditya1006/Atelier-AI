# =============================================
#  JobAgent AI - Environment Configuration
# =============================================

# REQUIRED: Get your Gemini API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# OPTIONAL: Gmail for sending cold emails to recruiters
# Use an App Password (not your real password): https://myaccount.google.com/apppasswords
GMAIL_EMAIL=your_email@gmail.com
GMAIL_APP_PASSWORD=your_gmail_app_password_here

# Server settings (don't change unless needed)
HOST=localhost
PORT=8000
DEBUG=true

# Database (auto-created, don't change)
DATABASE_URL=sqlite:///./data/jobagent.db
